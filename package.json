{
  "name": "doudou-agent",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "desktop:dev": "pnpm --filter doudou-agent-client tauri dev",
    "desktop:build": "pnpm --filter doudou-agent-client tauri build",
    "check": "pnpm run check:structure && pnpm run format:check && pnpm run lint:py && pnpm run format:py:check && pnpm run test:py && turbo run lint typecheck test build",
    "check:structure": "node --test tooling/tests/scaffold.test.mjs",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm run format:check && pnpm run lint:py && turbo run lint",
    "format:py": "uv run --directory services/agent_server ruff format .",
    "format:py:check": "uv run --directory services/agent_server ruff format --check .",
    "lint:py": "uv run --directory services/agent_server ruff check .",
    "setup:hooks": "git config core.hooksPath .githooks",
    "test": "pnpm run check:structure && pnpm run test:py && turbo run test",
    "typecheck": "turbo run typecheck",
    "server:dev": "uv run --directory services/agent_server uvicorn main:app --reload",
    "test:py": "uv run --directory services/agent_server pytest"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx,json,yml,yaml,md}": "prettier --write",
    "*.py": [
      "uv run --directory services/agent_server ruff check --fix",
      "uv run --directory services/agent_server ruff format"
    ]
  },
  "devDependencies": {
    "lint-staged": "^16.2.6",
    "prettier": "^3.8.3",
    "turbo": "^2.9.6"
  }
}
